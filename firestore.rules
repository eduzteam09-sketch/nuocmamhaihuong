rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@haihuong.vn';
    }

    // Products (Public read for catalogue, write allowed)
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    // Stores collection
    match /stores/{storeId} {
      allow read, write: if isValidId(storeId);
    }

    // Batches (Lô ủ chượp & truy xuất nguồn gốc)
    match /batches/{batchId} {
      allow read: if true; // Hỗ trợ quét mã QR truy xuất công khai
      allow write: if isValidId(batchId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    // Leads B2B collection
    match /leads/{leadId} {
      allow read, write: if isValidId(leadId);
    }

    // Staff collection (Super admin has highest authority, signed in staff can read)
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isValidId(staffId);
    }

    // System meta
    match /system_meta/{metaId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isValidId(metaId);
    }
  }
}
